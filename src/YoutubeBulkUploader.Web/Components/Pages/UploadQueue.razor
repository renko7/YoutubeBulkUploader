@page "/queue"
@rendermode InteractiveServer
@implements IDisposable
@inject UploadQueueManager QueueManager
@inject GoogleAuthService AuthService
@inject PlaylistService PlaylistService

<PageTitle>Upload Queue</PageTitle>

<h1>Upload Queue</h1>

@if (string.IsNullOrEmpty(_connectedChannelTitle))
{
    <div class="alert alert-warning">
        No Google account connected yet. Go to <a href="/setup">Setup</a> first.
    </div>
}
else
{
    <p class="text-muted">Connected as: <strong>@_connectedChannelTitle</strong></p>
}

<div class="card mb-3">
    <div class="card-body">
        @if (_rateStatus is not null)
        {
            <p>
                <strong>@_rateStatus.UsedInWindow / @_rateStatus.Limit</strong> uploads used in the current rolling 24-hour window.
                @if (_rateStatus.IsCapped && _rateStatus.NextSlotAtUtc is { } nextSlot)
                {
                    <span class="text-danger">
                        Limit reached &mdash; next slot opens at @nextSlot.ToLocalTime().ToString("g")
                        (in @FormatCountdown(nextSlot))
                    </span>
                }
            </p>
        }
        <button class="btn @(_isPaused ? "btn-success" : "btn-outline-secondary")" @onclick="ToggleQueue">
            @(_isPaused ? "Start Queue" : "Pause Queue")
        </button>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <label class="form-label">Folder path to scan for videos</label>
        <div class="input-group">
            <input class="form-control" @bind="_folderPath" @bind:event="oninput" placeholder="C:\Videos\ToUpload" />
            <button class="btn btn-primary" @onclick="ScanFolderAsync">Scan Folder</button>
        </div>
        @if (_scanMessage is not null)
        {
            <div class="form-text">@_scanMessage</div>
        }
        <div class="form-text">
            Tip: if a filename starts with a number (e.g. "01 - Intro.mp4"), that number is used as its
            playlist order automatically. Otherwise you can set the order manually below.
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <label class="form-label">Assign selected videos (@_selectedJobIds.Count) to a playlist</label>
        <div class="d-flex gap-2 align-items-start flex-wrap">
            <select class="form-select" style="max-width:280px" @bind="_selectedPlaylistOption">
                <option value="">-- choose a playlist --</option>
                <option value="__new__">+ Create new playlist</option>
                @foreach (var playlist in _playlists)
                {
                    <option value="@playlist.Id">@playlist.Title</option>
                }
            </select>

            @if (_selectedPlaylistOption == "__new__")
            {
                <input class="form-control" style="max-width:220px" @bind="_newPlaylistTitle" @bind:event="oninput" placeholder="New playlist name" />
                <select class="form-select" style="max-width:140px" @bind="_newPlaylistPrivacy">
                    <option value="@VideoPrivacy.Private">Private</option>
                    <option value="@VideoPrivacy.Unlisted">Unlisted</option>
                    <option value="@VideoPrivacy.Public">Public</option>
                </select>
            }

            <button class="btn btn-primary" disabled="@(!CanAssignPlaylist())" @onclick="AssignSelectedToPlaylistAsync">
                Assign Selected to Playlist
            </button>
        </div>
        @if (_playlistAssignMessage is not null)
        {
            <div class="form-text">@_playlistAssignMessage</div>
        }
    </div>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th><input type="checkbox" checked="@AllVisibleSelected()" @onchange="e => ToggleSelectAll((bool)e.Value!)" /></th>
            <th>File</th>
            <th>Title</th>
            <th>Privacy</th>
            <th>Status</th>
            <th>Progress</th>
            <th>Playlist</th>
            <th>Order</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var job in _jobs)
        {
            <tr>
                <td><input type="checkbox" checked="@_selectedJobIds.Contains(job.Id)" @onchange="e => ToggleSelection(job.Id, (bool)e.Value!)" /></td>
                <td title="@job.FilePath">@Path.GetFileName(job.FilePath)</td>
                <td>@job.Title</td>
                <td>@job.Privacy</td>
                <td>
                    <span class="badge @StatusBadgeClass(job.Status)">@job.Status</span>
                    @if (job.Status == UploadStatus.Failed && job.ErrorMessage is not null)
                    {
                        <div class="small text-danger">@job.ErrorMessage</div>
                    }
                    @if (job.Status == UploadStatus.Completed && job.YouTubeVideoId is not null)
                    {
                        <div class="small">
                            <a href="https://youtube.com/watch?v=@job.YouTubeVideoId" target="_blank" rel="noopener">View on YouTube</a>
                        </div>
                    }
                </td>
                <td style="min-width:120px;">
                    @if (job.Status == UploadStatus.Uploading)
                    {
                        <div class="progress" style="height:6px;">
                            <div class="progress-bar" style="width:@(job.ProgressPercent.ToString("F0"))%"></div>
                        </div>
                    }
                </td>
                <td>
                    @if (job.PlaylistId is not null)
                    {
                        <div>@job.PlaylistTitle</div>
                        @if (job.PlaylistError is not null)
                        {
                            <span class="badge bg-danger" title="@job.PlaylistError">Error</span>
                        }
                        else if (job.PlaylistItemId is not null)
                        {
                            <span class="badge bg-success">Added</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pending</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
                <td style="width:90px;">
                    <input type="number" class="form-control form-control-sm" value="@job.PlaylistOrder"
                           @onchange="e => OnOrderChangedAsync(job.Id, e.Value)" />
                </td>
                <td>
                    @if (job.Status == UploadStatus.Queued)
                    {
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveJobAsync(job.Id)">Remove</button>
                    }
                    @if (job.Status == UploadStatus.Failed)
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => RetryJobAsync(job.Id)">Retry</button>
                    }
                </td>
            </tr>
        }
        @if (_jobs.Count == 0)
        {
            <tr><td colspan="9" class="text-muted">Queue is empty. Scan a folder above to add videos.</td></tr>
        }
    </tbody>
</table>

@code {
    private List<UploadJob> _jobs = [];
    private RateLimitStatus? _rateStatus;
    private bool _isPaused = true;
    private string _folderPath = string.Empty;
    private string? _scanMessage;
    private string? _connectedChannelTitle;
    private Timer? _refreshTimer;

    private List<PlaylistSummary> _playlists = [];
    private readonly HashSet<int> _selectedJobIds = [];
    private string _selectedPlaylistOption = string.Empty;
    private string _newPlaylistTitle = string.Empty;
    private VideoPrivacy _newPlaylistPrivacy = VideoPrivacy.Private;
    private string? _playlistAssignMessage;

    protected override async Task OnInitializedAsync()
    {
        QueueManager.OnChanged += HandleChanged;
        _refreshTimer = new Timer(_ => InvokeAsync(RefreshAsync), null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
        _connectedChannelTitle = await AuthService.GetConnectedChannelTitleAsync();
        await RefreshAsync();
        await LoadPlaylistsAsync();
    }

    private async Task RefreshAsync()
    {
        _jobs = await QueueManager.GetSnapshotAsync();
        _rateStatus = await QueueManager.GetRateLimitStatusAsync();
        _isPaused = QueueManager.IsPaused;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadPlaylistsAsync()
    {
        var credential = await AuthService.GetCredentialAsync();
        if (credential is null)
        {
            return;
        }

        try
        {
            _playlists = await PlaylistService.GetPlaylistsAsync(credential);
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Best-effort; the assign toolbar will just show no existing playlists.
        }
    }

    private void HandleChanged() => _ = InvokeAsync(RefreshAsync);

    private async Task ScanFolderAsync()
    {
        if (string.IsNullOrWhiteSpace(_folderPath))
        {
            _scanMessage = "Enter a folder path first.";
            return;
        }

        try
        {
            var added = await QueueManager.ScanFolderAsync(_folderPath.Trim());
            _scanMessage = added switch
            {
                0 => "No new video files found in that folder.",
                1 => "Added 1 video to the queue.",
                _ => $"Added {added} videos to the queue."
            };
        }
        catch (DirectoryNotFoundException)
        {
            _scanMessage = "That folder doesn't exist.";
        }

        await RefreshAsync();
    }

    private async Task RemoveJobAsync(int id)
    {
        await QueueManager.RemoveJobAsync(id);
    }

    private async Task RetryJobAsync(int id)
    {
        await QueueManager.RetryJobAsync(id);
    }

    private void ToggleQueue()
    {
        if (_isPaused)
        {
            QueueManager.Resume();
        }
        else
        {
            QueueManager.Pause();
        }
    }

    private void ToggleSelection(int jobId, bool isChecked)
    {
        if (isChecked)
        {
            _selectedJobIds.Add(jobId);
        }
        else
        {
            _selectedJobIds.Remove(jobId);
        }
    }

    private bool AllVisibleSelected() => _jobs.Count > 0 && _jobs.All(j => _selectedJobIds.Contains(j.Id));

    private void ToggleSelectAll(bool isChecked)
    {
        if (isChecked)
        {
            foreach (var job in _jobs)
            {
                _selectedJobIds.Add(job.Id);
            }
        }
        else
        {
            _selectedJobIds.Clear();
        }
    }

    private bool CanAssignPlaylist()
    {
        if (_selectedJobIds.Count == 0 || string.IsNullOrEmpty(_selectedPlaylistOption))
        {
            return false;
        }

        return _selectedPlaylistOption != "__new__" || !string.IsNullOrWhiteSpace(_newPlaylistTitle);
    }

    private async Task AssignSelectedToPlaylistAsync()
    {
        var credential = await AuthService.GetCredentialAsync();
        if (credential is null)
        {
            _playlistAssignMessage = "Connect your Google account first.";
            return;
        }

        try
        {
            string playlistId;
            string playlistTitle;

            if (_selectedPlaylistOption == "__new__")
            {
                var created = await PlaylistService.CreatePlaylistAsync(credential, _newPlaylistTitle.Trim(), _newPlaylistPrivacy);
                playlistId = created.Id;
                playlistTitle = created.Title;
                _playlists.Add(created);
            }
            else
            {
                var existing = _playlists.First(p => p.Id == _selectedPlaylistOption);
                playlistId = existing.Id;
                playlistTitle = existing.Title;
            }

            await QueueManager.AssignPlaylistAsync(_selectedJobIds, playlistId, playlistTitle);
            _playlistAssignMessage = $"Assigned {_selectedJobIds.Count} video(s) to \"{playlistTitle}\".";
            _selectedJobIds.Clear();
            _newPlaylistTitle = string.Empty;
            _selectedPlaylistOption = string.Empty;
        }
        catch (Exception ex)
        {
            _playlistAssignMessage = $"Couldn't assign playlist: {ex.Message}";
        }

        await RefreshAsync();
    }

    private async Task OnOrderChangedAsync(int jobId, object? value)
    {
        var order = int.TryParse(value?.ToString(), out var parsed) ? parsed : (int?)null;
        await QueueManager.SetPlaylistOrderAsync(jobId, order);
    }

    private static string StatusBadgeClass(UploadStatus status) => status switch
    {
        UploadStatus.Queued => "bg-secondary",
        UploadStatus.Uploading => "bg-primary",
        UploadStatus.Completed => "bg-success",
        UploadStatus.Failed => "bg-danger",
        _ => "bg-secondary"
    };

    private static string FormatCountdown(DateTime targetUtc)
    {
        var remaining = targetUtc - DateTime.UtcNow;
        if (remaining <= TimeSpan.Zero)
        {
            return "now";
        }

        return remaining.TotalHours >= 1
            ? $"{(int)remaining.TotalHours}h {remaining.Minutes}m"
            : $"{remaining.Minutes}m {remaining.Seconds}s";
    }

    public void Dispose()
    {
        QueueManager.OnChanged -= HandleChanged;
        _refreshTimer?.Dispose();
    }
}
